---
import HomeLayout from '../layouts/HomeLayout.astro'
import { profile, education, experience, skills } from '../data/portfolio'
import { getCollection } from 'astro:content'
import { Github, Linkedin, Mail } from 'lucide-react'

const allBlogs = await getCollection('blog')
const recentBlogs = allBlogs
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
---

<HomeLayout>
  <main class="max-w-4xl mx-auto px-6">

    <!-- Hero -->
    <section class="py-16 flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-10">
      <img
        src={profile.image}
        alt={profile.name}
        class="w-28 h-28 rounded-full ring-2 ring-accent/25 ring-offset-2 ring-offset-white dark:ring-offset-gray-950 shrink-0"
      />
      <div>
        <h1 class="text-5xl font-bold tracking-tight">{profile.name}</h1>
        <p class="text-accent text-lg font-medium mt-2">{profile.title}</p>
        <div class="flex items-center gap-4 mt-5">
          <a
            href={profile.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-400 hover:text-accent dark:text-gray-500 dark:hover:text-accent transition-colors"
          >
            <Github size={22} />
          </a>
          <a
            href={profile.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-400 hover:text-accent dark:text-gray-500 dark:hover:text-accent transition-colors"
          >
            <Linkedin size={22} />
          </a>
          <a
            href={`mailto:${profile.email}`}
            aria-label="Email"
            class="text-gray-400 hover:text-accent dark:text-gray-500 dark:hover:text-accent transition-colors"
          >
            <Mail size={22} />
          </a>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="py-12 border-t border-gray-100 dark:border-gray-800/80">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent shrink-0">Education</span>
        <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800" />
      </div>
      <div class="space-y-7">
        {education.map((edu) => (
          <div class="flex gap-5">
            <div class="shrink-0">
              <div class="w-24 h-24 rounded-xl bg-gray-50 dark:bg-gray-800/80 flex items-center justify-center overflow-hidden border border-gray-100 dark:border-gray-800">
                <img src={edu.imgSrc} alt={edu.schoolName} class="w-20 h-20 object-contain block dark:hidden" />
                <img src={edu.imgSrcDark ?? edu.imgSrc} alt={edu.schoolName} class="w-20 h-20 object-contain hidden dark:block" />
              </div>
            </div>
            <div class="min-w-0 flex flex-col justify-center gap-0.5">
              <p class="text-xl font-semibold text-gray-900 dark:text-gray-100 leading-snug">{edu.schoolName}</p>
              <p class="text-lg text-gray-600 dark:text-gray-400">{edu.degree}</p>
              <p class="text-base text-gray-400 dark:text-gray-500">{edu.date}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-12 border-t border-gray-100 dark:border-gray-800/80">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent shrink-0">Experience</span>
        <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800" />
      </div>
      <div class="space-y-7">
        {experience.map((exp) => (
          <div class="flex gap-5">
            <div class="shrink-0">
              <div class="w-24 h-24 rounded-xl bg-gray-50 dark:bg-gray-800/80 flex items-center justify-center overflow-hidden border border-gray-100 dark:border-gray-800">
                <img src={exp.imgSrc} alt={exp.companyName} class="w-20 h-20 object-contain block dark:hidden" />
                <img src={exp.imgSrcDark ?? exp.imgSrc} alt={exp.companyName} class="w-20 h-20 object-contain hidden dark:block" />
              </div>
            </div>
            <div class="min-w-0 flex flex-col justify-center gap-0.5">
              <p class="text-xl font-semibold text-gray-900 dark:text-gray-100 leading-snug">{exp.companyName}</p>
              <p class="text-lg text-gray-600 dark:text-gray-400">{exp.position}</p>
              <p class="text-base text-gray-400 dark:text-gray-500">{exp.date}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="py-12 border-t border-gray-100 dark:border-gray-800/80">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent shrink-0">Skills</span>
        <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6">
        {skills.map((skill) => (
          <div>
            <div class="flex justify-between items-baseline mb-2">
              <span class="text-lg font-medium text-gray-700 dark:text-gray-300">{skill.name}</span>
              <span class="text-base text-gray-400 dark:text-gray-500">{skill.level}%</span>
            </div>
            <div class="h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
              <div
                class="h-full bg-accent rounded-full"
                style={`width: ${skill.level}%`}
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Recent Posts -->
    {recentBlogs.length > 0 && (
      <section class="py-12 border-t border-gray-100 dark:border-gray-800/80">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-xs font-semibold uppercase tracking-widest text-accent shrink-0">Recent Posts</span>
          <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800" />
          <a
            href="/blogs"
            class="text-sm text-gray-400 dark:text-gray-500 hover:text-accent transition-colors whitespace-nowrap"
          >
            View all →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {recentBlogs.map((blog) => (
            <a href={`/blogs/${blog.slug}`} class="group block">
              {blog.data.image && (
                <div class="aspect-video overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800/80 mb-3">
                  <img
                    src={blog.data.image.path}
                    alt={blog.data.image.alt || blog.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="text-base text-gray-400 dark:text-gray-500">{blog.data.date}</span>
                {blog.data.categories && blog.data.categories.map((cat) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-accent-muted text-accent font-medium">
                    {cat}
                  </span>
                ))}
              </div>
              <p class="text-lg font-medium text-gray-900 dark:text-gray-100 group-hover:text-accent transition-colors line-clamp-2">
                {blog.data.title}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="h-16" />
  </main>
</HomeLayout>
