# Cloudflare R2 Configuration
# Your Cloudflare Account ID (found on the R2 overview page)
R2_ACCOUNT_ID=your_account_id

# R2 API Tokens (generated in R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# The name of your R2 bucket
R2_BUCKET_NAME=your_bucket_name

# Your R2 Public Domain (e.g., https://assets.yourdomain.com or the r2.dev URL)
# Ensure this is configured in the bucket's "Settings" tab under "Public Access"
PUBLIC_R2_URL=https://your-public-domain.com
